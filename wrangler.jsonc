// Publica este repositorio en Cloudflare como sitio estático (sin código de servidor).
// GitHub Pages sigue funcionando igual; esto solo agrega una segunda dirección.
{
  "name": "revelio-boda",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,      // la dirección revelio-boda.kilers0opa.workers.dev
  "preview_urls": false,
  "assets": {
    "directory": "./",
    // Las direcciones se quedan tal cual (/panel.html, no /panel): Revelio
    // se guía por "panel.html" para saber si está en el panel o como invitado.
    "html_handling": "none",
    // "/" y cualquier dirección desconocida abren la página de invitados
    "not_found_handling": "single-page-application"
  }
}
